# Порт HTTP сервера
PORT=3000

# Токен Telegram Бота (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Список ID Telegram-каналів або чатів для прослуховування (через кому, наприклад: -1001234567890,-1009876543210)
# Якщо залишити порожнім, бот оброблятиме всі повідомлення з підключених чатів/каналів
ALLOWED_CHANNELS=

# Ключ OpenAI API для вилучення координат та типу загрози з тексту
OPENAI_API_KEY=your_openai_api_key_here

# Модель OpenAI (gpt-4o-mini або gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Шлях до бази даних SQLite
DB_PATH=./data/radar.db
