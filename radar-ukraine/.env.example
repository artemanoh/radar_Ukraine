# Порт запуску сервера
PORT=3000

# Токен Telegram Бота для прослуховування моніторингових каналів
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Список ID каналів через кому (якщо порожньо — обробка з усіх підключених)
ALLOWED_CHANNELS=

# Ключ OpenAI API для структуризації повідомлень у геодані
OPENAI_API_KEY=your_openai_api_key_here

# Модель OpenAI для парсингу (gpt-4o-mini або gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Шлях до файлу бази даних SQLite
DB_PATH=./data/radar.db
