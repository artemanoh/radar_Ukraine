PORT=3000
NEPTUN_API_URL=https://neptun.in.ua

# Токен офіційного сервісу alerts.in.ua (https://alerts.in.ua)
ALERTS_IN_UA_TOKEN=

# Ключ картографічного сервісу CARTO Basemaps (https://carto.com/basemaps/apikey)
# Необхідний для завантаження детальних темних векторних/растрових тайлів та назв населених пунктів.
# Отримайте ключ на сторінці https://carto.com/basemaps/apikey і вкажіть його тут:
CARTO_API_KEY=
# Також підтримуються альтернативні назви змінних для Node.js та Vite:
MAP_API_KEY=
VITE_CARTO_API_KEY=
VITE_MAP_API_KEY=

# Опціональний ключ Google Gemini API для розширеного аналізу моніторингових Telegram-повідомлень.
# За відсутності ключа система автоматично використовує швидкий локальний NLP-рушій без виклику зовнішніх API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
